<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.description }}">
<link rel="canonical" href="{{ site.url }}">
<meta property="og:title" content="{{ site.title }}">
<meta property="og:description" content="{{ site.share_description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}">
<meta property="og:image" content="https://vedantjumle.com/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ site.title }}">
<meta name="twitter:description" content="{{ site.share_description }}">
<meta name="twitter:image" content="https://vedantjumle.com/og-image.png">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": {{ name | tojson }},
  "jobTitle": "AI Researcher",
  "url": {{ site.url | tojson }},
  "image": {{ (site.url ~ photo) | tojson }},
  "email": {{ ("mailto:" ~ contact.email) | tojson }},
  "sameAs": {{ [contact.github, contact.linkedin] | tojson }}
}
</script>
<script>
(function () {
  var t = null;
  try { t = localStorage.getItem('seahorse-theme'); } catch (e) {}
  if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
})();
</script>
<script defer data-domain="vedantjumle.com" src="https://plausible.io/js/plausible.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
<style>
:root {
  color-scheme: light;
  --bg: #f8f7f3; --surface: #fdfcf9; --ink: #17191c; --ink-2: #44474d; --muted: #75777c;
  --rule: #e2e0d8; --chip: #efede6; --accent: #c2185b; --link: #0b5fc0; --flash: #fbe3ec;
  --mono: 'Fira Code', ui-monospace, Menlo, monospace;
  --ui: 'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --serif: 'Source Serif 4', Georgia, serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #0e0e13; --surface: #15151b; --ink: #ececef; --ink-2: #b9bcc4; --muted: #868a93;
    --rule: #26262f; --chip: #1c1c23; --accent: #ff2d78; --link: #5cc8ff; --flash: #2a1520;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #0e0e13; --surface: #15151b; --ink: #ececef; --ink-2: #b9bcc4; --muted: #868a93;
  --rule: #26262f; --chip: #1c1c23; --accent: #ff2d78; --link: #5cc8ff; --flash: #2a1520;
}

* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
body { margin: 0; background: var(--bg); color: var(--ink); font: 16.5px/1.65 var(--ui); }
a { color: var(--link); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 3px; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
p { margin: 0 0 14px; }

.wrap { width: min(760px, calc(100% - 32px)); margin: 0 auto; }

/* top bar */
.topbar { display: flex; justify-content: flex-end; padding: 18px 0 0; }
.topbar button { font: 13px var(--mono); color: var(--muted); background: none; border: 1px solid var(--rule);
  border-radius: 999px; padding: 4px 12px; cursor: pointer; transition: color .15s, border-color .15s; }
.topbar button:hover { color: var(--ink); border-color: var(--muted); }

/* hero */
header.hero { display: flex; gap: 28px; align-items: center; padding: 40px 0 44px; border-bottom: 1px solid var(--rule); }
.hero img { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; object-position: 50% 30%;
  flex-shrink: 0; border: 1px solid var(--rule); background: var(--chip); }
.hero h1 { font: 600 clamp(32px, 6vw, 44px)/1.1 var(--serif); letter-spacing: -.015em; margin: 0 0 8px; }
.hero .tag { font-size: 17.5px; color: var(--ink-2); margin: 0 0 14px; }
.links { display: flex; flex-wrap: wrap; gap: 6px 18px; font: 13.5px var(--mono); margin: 0; padding: 0; list-style: none; }
.links a { color: var(--ink-2); }
.links a:hover { color: var(--accent); text-decoration: none; }
.links a::after { content: " ↗"; color: var(--muted); font-size: .9em; }
.links a[href^="mailto"]::after { content: ""; }

/* sections */
section.block { display: grid; grid-template-columns: 132px 1fr; gap: 0 32px; padding: 40px 0; border-bottom: 1px solid var(--rule); }
section.block > h2 { font: 500 12.5px/2.2 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin: 0; }
section.block > .body { min-width: 0; }
.lede { font: 18.5px/1.65 var(--serif); color: var(--ink); }
.lede p:last-child { margin-bottom: 0; }

/* featured */
.feature { background: var(--surface); border: 1px solid var(--rule); border-left: 3px solid var(--accent);
  border-radius: 8px; padding: 22px 24px 20px; scroll-margin-top: 24px; }
.feature .kicker { font: 500 12px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
.feature h3 { font: 600 23px/1.25 var(--serif); margin: 0 0 10px; }
.feature h3 a { color: var(--ink); }
.feature h3 a:hover { color: var(--accent); text-decoration: none; }
.feature p { color: var(--ink-2); }
.feature .paper { font-size: 15px; color: var(--ink-2); padding: 10px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); margin: 4px 0 14px; }
.feature .paper em { color: var(--ink); }
.actions { display: flex; flex-wrap: wrap; gap: 8px; }
.btn { font: 500 13.5px var(--ui); padding: 6px 14px; border-radius: 999px; border: 1px solid var(--rule); color: var(--ink); background: var(--bg);
  transition: border-color .15s, color .15s; }
.btn:hover { text-decoration: none; border-color: var(--accent); color: var(--accent); }
.btn.primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.btn.primary:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
.explainers { margin: 18px 0 0; font-size: 14.5px; color: var(--muted); }
.explainers ul { list-style: none; padding: 0; margin: 6px 0 0; }
.explainers li { margin: 3px 0; }
.explainers li::before { content: "→ "; color: var(--muted); }

/* entry lists */
.entries { list-style: none; margin: 0; padding: 0; }
.entry { padding: 14px 0; scroll-margin-top: 24px; transition: background-color .6s, box-shadow .6s; }
.entry + .entry { border-top: 1px solid var(--rule); }
.entry:first-child { padding-top: 2px; }
.entry h3 { font: 600 16.5px/1.4 var(--ui); margin: 0 0 4px; }
.entry h3 a { color: var(--ink); }
.entry h3 a:hover { color: var(--accent); text-decoration: none; }
.entry .meta { font: 13px var(--mono); color: var(--muted); margin: 0 0 6px; }
.entry p { color: var(--ink-2); font-size: 15.5px; margin: 0 0 8px; }
.entry p:last-child { margin-bottom: 0; }
.row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; font-size: 14px; }
.tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
.tags li { font: 12px var(--mono); color: var(--ink-2); background: var(--chip); padding: 1px 8px; border-radius: 4px; }
.row .go { margin-left: auto; display: flex; gap: 14px; }
.go a { font: 13.5px var(--mono); }
.writing .entry { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
.writing .entry h3 { margin: 0; font-weight: 500; }
.writing .meta { margin: 0; white-space: nowrap; }

.entry.flash { background-color: var(--flash); box-shadow: 0 0 0 10px var(--flash); border-radius: 2px; }
.feature.flash { background-color: var(--flash); }

footer { padding: 32px 0 56px; font: 13.5px var(--mono); color: var(--muted); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; }
footer a { color: var(--ink-2); }

@media (max-width: 640px) {
  header.hero { flex-direction: column; align-items: flex-start; gap: 18px; padding: 24px 0 32px; }
  .hero img { width: 88px; height: 88px; }
  section.block { grid-template-columns: 1fr; padding: 32px 0; }
  section.block > h2 { margin-bottom: 12px; }
  .row .go { margin-left: 0; }
  .writing .entry { flex-direction: column; gap: 2px; }
  .feature { padding: 18px 18px 16px; }
}
</style>
</head>
<body>
<div class="wrap">

<div class="topbar">
  <button id="theme-toggle" type="button" aria-label="Toggle light and dark theme">◐ theme</button>
</div>

<header class="hero">
  <img src="{{ photo }}" alt="Portrait of {{ name }}" width="112" height="112">
  <div>
    <h1>{{ name }}</h1>
    <p class="tag">{{ tagline }}</p>
    <ul class="links" aria-label="Profiles">
{%- for l in links %}
      <li><a{% if l.id %} id="{{ l.id }}"{% endif %} href="{{ l.url }}">{{ l.label }}</a></li>
{%- endfor %}
    </ul>
  </div>
</header>

<main>

<section class="block" id="about" aria-labelledby="h-about">
  <h2 id="h-about">About</h2>
  <div class="body lede">
{%- for p in about %}
    <p>{{ p }}</p>
{%- endfor %}
  </div>
</section>

<section class="block" id="research" aria-labelledby="h-research">
  <h2 id="h-research">Research</h2>
  <div class="body">
{%- if featured %}
    <article class="feature" id="{{ featured.id }}">
      <p class="kicker">{{ featured.kicker }}</p>
      <h3><a href="{{ featured.url }}">{{ featured.title }}</a></h3>
      <p>{{ featured.summary }}</p>
{%- if featured.paper %}
      <p class="paper">{{ featured.paper.label }} · <em>{{ featured.paper.title }}</em>{% if featured.paper.ref %} · {{ featured.paper.ref }}{% endif %}</p>
{%- endif %}
{%- if featured.buttons %}
      <div class="actions">
{%- for b in featured.buttons %}
        <a class="btn{% if b.primary %} primary{% endif %}" href="{{ b.url }}">{{ b.label }}{% if b.external %} ↗{% endif %}</a>
{%- endfor %}
      </div>
{%- endif %}
{%- if featured.explainers %}
      <div class="explainers">Explainers
        <ul>
{%- for e in featured.explainers %}
          <li><a href="{{ e.url }}">{{ e.title }}</a></li>
{%- endfor %}
        </ul>
      </div>
{%- endif %}
    </article>
{%- endif %}

    <ul class="entries"{% if featured %} style="margin-top:22px"{% endif %}>
{%- for r in research %}
      <li class="entry" id="{{ r.id }}">
        <h3><a href="{{ r.url }}">{{ r.title }}</a></h3>
{%- if r.meta %}
        <p class="meta">{{ r.meta }}</p>
{%- endif %}
{%- if r.desc %}
        <p>{{ r.desc }}</p>
{%- endif %}
      </li>
{%- endfor %}
    </ul>
  </div>
</section>

<section class="block writing" id="blog" aria-labelledby="h-blog">
  <h2 id="h-blog">Writing</h2>
  <div class="body">
    <ul class="entries">
{%- for w in writing %}
      <li class="entry" id="{{ w.id }}">
        <h3><a href="{{ w.url }}">{{ w.title }}</a></h3>
        <p class="meta">{{ w.source }}</p>
      </li>
{%- endfor %}
    </ul>
  </div>
</section>

<section class="block" id="projects" aria-labelledby="h-projects">
  <h2 id="h-projects">Projects</h2>
  <div class="body">
    <ul class="entries">
{%- for p in projects %}
      <li class="entry" id="{{ p.id }}">
        <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
        <p>{{ p.desc }}</p>
        <div class="row">
          <ul class="tags">{% for t in p.tags or [] %}<li>{{ t }}</li>{% endfor %}</ul>
          <span class="go">{% for l in p.links or [] %}<a href="{{ l.url }}">{{ l.label }}{% if l.external %} ↗{% endif %}</a>{% endfor %}</span>
        </div>
      </li>
{%- endfor %}
    </ul>
  </div>
</section>

</main>

<footer id="contact">
  <span>© {{ copyright_year }} {{ name }}</span>
  <span><a href="mailto:{{ contact.email }}">{{ contact.email }}</a> · <a href="{{ contact.github }}">github</a> · <a href="{{ contact.linkedin }}">linkedin</a></span>
</footer>

</div>

<script>
(function () {
  var root = document.documentElement;
  document.getElementById('theme-toggle').addEventListener('click', function () {
    var cur = root.getAttribute('data-theme') ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    var next = cur === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('seahorse-theme', next); } catch (e) {}
  });

  // Old links like #projects/buzztrends or #blog/<slug>/ point at the last path segment.
  function followHash(e) {
    var parts = decodeURIComponent(location.hash.slice(1)).split('/').filter(Boolean);
    if (parts.length < 2) return;
    var el = document.getElementById(parts[parts.length - 1]) || document.getElementById(parts[0]);
    if (!el) return;
    el.scrollIntoView({ block: 'start', behavior: e ? 'smooth' : 'instant' });
    el.classList.add('flash');
    setTimeout(function () { el.classList.remove('flash'); }, 1400);
  }
  window.addEventListener('hashchange', followHash);
  followHash();
})();
</script>
</body>
</html>
